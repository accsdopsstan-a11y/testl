# Whop Embedded App - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Whop API Credentials
# =============================================================================

# Your Whop API key (from https://whop.com/dashboard/developer)
# Use an App API key if building an app for others
# Use a Company API key if building for your own company only
WHOP_API_KEY=your_api_key_here

# Webhook secret for validating incoming webhooks
# Get this from your Whop app settings / webhook configuration
WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# OPTIONAL: Database Configuration
# =============================================================================

# Database URL (leave empty to run without database)
# PostgreSQL: postgresql://user:password@localhost:5432/dbname
# SQLite: sqlite:///./app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/whop_app

# =============================================================================
# OPTIONAL: Application Settings
# =============================================================================

# Enable development mode (relaxed security, detailed errors, docs enabled)
# Set to "true" for local development, "false" for production
DEV_MODE=true

# Application name (displayed in logs and UI)
APP_NAME=Whop Embedded App

# Server binding
APP_HOST=0.0.0.0
APP_PORT=8000

# =============================================================================
# OPTIONAL: Whop API Configuration
# =============================================================================

# Whop API base URL (default: https://api.whop.com/api/v5)
# Only change if Whop updates their API version
# WHOP_API_BASE_URL=https://api.whop.com/api/v5

# =============================================================================
# OPTIONAL: External Services (for scripts)
# =============================================================================

# Slack webhook URL for notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Discord webhook URL for notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Email service API key (e.g., SendGrid, Resend)
# EMAIL_API_KEY=your_email_api_key
